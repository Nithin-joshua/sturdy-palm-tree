# ==============================================================================
# Multimodal Industrial Inspection Agent - Configuration Template
# Copy this file to .env and customize as needed:
#   cp .env.example .env (Linux/macOS) or copy .env.example .env (Windows)
# ==============================================================================

# --- Server & Network ---
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=*
MAX_UPLOAD_SIZE_MB=25
OUTPUTS_DIR=outputs

# --- Vision Detector Backend ---
# Supported options: heuristic | vlm | qwen | yolo | auto
# Default: 'heuristic' runs instantly on any laptop without GPU or heavy dependencies.
INSPECTION_DETECTOR=heuristic
INSPECTION_CONFIDENCE_THRESHOLD=0.25

# --- Optional: OpenAI-compatible VLM Backend (Ollama, vLLM, OpenAI) ---
# Uncomment when INSPECTION_DETECTOR=vlm
# INSPECTION_VLM_MODEL=qwen2.5vl
# INSPECTION_VLM_BASE_URL=http://localhost:11434/v1
# INSPECTION_VLM_API_KEY=ollama

# --- Optional: Local Qwen-VL Backend (requires GPU + backend/requirements-vision.txt) ---
# Uncomment when INSPECTION_DETECTOR=qwen
# INSPECTION_QWEN_MODEL=Qwen/Qwen2.5-VL-3B-Instruct
# INSPECTION_QWEN_DEVICE=auto
# INSPECTION_QWEN_MAX_NEW_TOKENS=256

# --- Optional: YOLO Defect Detector (requires backend/requirements-vision.txt + model) ---
# Uncomment when INSPECTION_DETECTOR=yolo
# INSPECTION_YOLO_MODEL=runs/defect/best.pt
# INSPECTION_YOLO_CLASS_MAP=0=crack,1=corrosion
