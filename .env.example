# ==============================================================================
# Multimodal Industrial Inspection Agent - Configuration Template
# Copy this file to .env and customize as needed:
#   cp .env.example .env (Linux/macOS) or copy .env.example .env (Windows)
# ==============================================================================

# --- Server & Network ---
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=*
MAX_UPLOAD_SIZE_MB=25
OUTPUTS_DIR=outputs

# --- Vision Detector Backend ---
# Options: heuristic (default) | vlm (OpenRouter/Cloud) | qwen (local) | yolo (local)
INSPECTION_DETECTOR=heuristic
INSPECTION_CONFIDENCE_THRESHOLD=0.25

# --- Cloud Vision VLM: OpenRouter (Free Open Source Models) ---
# To activate: change INSPECTION_DETECTOR to 'vlm' and insert your key below
INSPECTION_VLM_BASE_URL=https://openrouter.ai/api/v1
INSPECTION_VLM_MODEL=meta-llama/llama-3.2-11b-vision-instruct:free
# Other free options:
# INSPECTION_VLM_MODEL=qwen/qwen-2.5-vl-72b-instruct:free
# INSPECTION_VLM_MODEL=google/gemini-2.0-flash-exp:free

# Paste your OpenRouter API key below (get from https://openrouter.ai/keys)
INSPECTION_VLM_API_KEY=your_openrouter_api_key_here

# --- Optional: Local Qwen-VL Backend (requires GPU + backend/requirements-vision.txt) ---
# Uncomment when INSPECTION_DETECTOR=qwen
# INSPECTION_QWEN_MODEL=Qwen/Qwen2.5-VL-3B-Instruct
# INSPECTION_QWEN_DEVICE=auto
# INSPECTION_QWEN_MAX_NEW_TOKENS=256

# --- Optional: YOLO Defect Detector (requires backend/requirements-vision.txt + model) ---
# Uncomment when INSPECTION_DETECTOR=yolo
# INSPECTION_YOLO_MODEL=runs/defect/best.pt
# INSPECTION_YOLO_CLASS_MAP=0=crack,1=corrosion
